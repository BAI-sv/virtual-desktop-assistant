{
  "brain": {
    "provider": "deepseek",
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "qwen2.5:7b"
    },
    "system_prompt": "你是FairyX，运行在用户的Windows电脑上，是用户的AI助手。负责：1)自然语言对话；2)通过工具操控电脑（软件、文件、窗口、截图、剪贴板、搜索、计算等）。需要执行电脑操作时，输出JSON动作块：<<<TOOL>>>{\"tool\":\"工具名\",\"params\":{...}}<<<END>>>。回复保持简洁、口语化、中文。",
    "history_limit": 20,
    "providers": [
      {
        "name": "Strata 176B（本地最强大脑，可选）",
        "enabled": false,
        "base_url": "http://127.0.0.1:8080/v1",
        "model": "<Strata 模型名，如 qwen3.8-flash-next-unsloth-ud-iq4_xs>",
        "api_key": "none",
        "timeout": 600,
        "max_tokens": 4096,
        "strata": true,
        "extra_body": {
          "chat_template_kwargs": {
            "enable_thinking": false
          },
          "temperature": 0.3
        },
        "note": "Strata 拆分部署的大模型（如 Qwen3.8-Flash-Next 176B）。未运行时 FairyX 会自动拉起 run-*.bat（需在 paths.strata_dir 配置目录）；深思考任务可去掉 enable_thinking"
      },
      {
        "name": "云端 API（示例）",
        "enabled": false,
        "base_url": "https://api.example.com/v1",
        "model": "your-model",
        "api_key": "<你的 API Key>",
        "timeout": 120,
        "max_tokens": 1024,
        "extra_body": {},
        "note": "任意 OpenAI 兼容云端接口示例：DeepSeek / OpenAI / 中转站等"
      },
      {
        "name": "Ollama 本地模型",
        "enabled": true,
        "base_url": "http://127.0.0.1:11434/v1",
        "model": "<ollama 已 pull 的模型名>",
        "api_key": "ollama",
        "timeout": 300,
        "max_tokens": 1024,
        "extra_body": {},
        "note": "ollama pull 后即可用；多个模型可复制多条"
      }
    ],
    "active_provider": "",
    "chain_note": "providers 顺序=优先级，第一个可用的大脑生效并记忆为 active_provider",
    "strata_thinking": {
      "simple": [
        "等于",
        "是多少",
        "几点",
        "日期",
        "翻译",
        "什么意思",
        "定义",
        "查一下",
        "语法",
        "怎么写",
        "多少钱",
        "回显",
        "刚才"
      ],
      "hard": [
        "为什么",
        "怎么办",
        "分析",
        "对比",
        "权衡",
        "方案",
        "建议",
        "优化",
        "调试",
        "原理",
        "创作",
        "规划",
        "区别",
        "优缺点"
      ],
      "hard_min_len": 60,
      "note": "Strata 176B 自适应思考配置：命中 simple 且不含调试类→直答秒回；命中 hard 或长问题→开思考链。可按需增删关键词"
    }
  },
  "voice": {
