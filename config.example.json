  },
  "consent": {
    "scan": false,
    "install": false,
    "system_change": false,
    "note": "使用人授权：首次运行会弹窗询问。scan=允许扫描本机软件/硬件/文件；install=允许自动下载安装软件；system_change=允许修改系统设置。全部默认false，须使用人同意后开启"
  }
}