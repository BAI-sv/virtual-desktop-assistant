# ============ FairyX .gitignore ============
# 素材/模型/大数据（不进仓库，README 说明如何获取）
voice/voices/
voice/index_voices/
voice/cache_*.wav
voice/voice_index.json
voice/line_map.json
voice/line_pools.json
voice/*.bak*
models/
wakeword/
everything/
downloads/
assets/whale/
assets/*.gif

# 配置（含本机路径与授权状态，只提交示例模板）
config.json
fairy.json
fairy_root.json
fairy_ball_pos.json

# 运行数据 / 日志 / 扫描报告（含本机文件清单，隐私）
data/
logs/
backup/
scan_report*

# 历史备份
*.bak_before_*
tools/archive/
*_to_delete_*

# 临时与缓存
__pycache__/
*.pyc
*.pyo
*.tmp
*.log
desktop.ini
Thumbs.db

# 测试输出
tools/*.txt
data/*.txt

# 本地维护工具（不随仓库分发，本地运行）
tools/clean_repo.py

# 内部文档（发布前清理；以下模式命中即不入库）
tools/*验证结论*.md
tools/*接入设计书*.md
tools/*_contract*.md
tools/*定案*.md
tools/黑窗*.md
docs/黑窗*.md
tools/看耳机*.bat
tools/看耳*.bat
tools/听音识曲*.bat
tools/听音色.bat
tools/听音色*.py
tools/_standalone_tests/
tools/音色定案.md
docs/功能全景与补全路线.md
docs/窗口对接_*.md
